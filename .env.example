# Postgres — instância local/dev (nunca aponte para produção a partir daqui)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/central_imoveis?schema=public"

# Chave usada para assinar o cookie de sessão do painel (gerar com: openssl rand -base64 32)
SESSION_SECRET=""

# Usados apenas pelo script `npm run prisma:seed` para criar o usuário admin do painel
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Número de WhatsApp do cliente (DDI+DDD+número, só dígitos, ex: 5511999999999)
WHATSAPP_PHONE=""

# Token de leitura/escrita do Vercel Blob (usado para upload de fotos dos imóveis)
# Criar em: Vercel dashboard > Storage > Blob > seu store > .env.local
BLOB_READ_WRITE_TOKEN=""
